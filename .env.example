# Copia este archivo a .env en cada servidor (NO lo subas a git).
# Genera secretos con:  openssl rand -base64 36

# ---- Instancia ----
COMPOSE_PROJECT_NAME=budodesk          # usa otro nombre si dev y prod viven en el mismo servidor (p. ej. budodesk-dev)
HTTP_PORT=8800                         # puerto donde escucha nginx (tu proxy/Cloudflare apunta aquí)
DEFAULT_DOJO_SLUG=seikoukan            # dojo por defecto si el subdominio no lo indica
APP_BASE_URL=https://seikoukan.budodesk.com   # se usa en los enlaces de los correos

# ---- Base de datos ----
DB_ROOT_PASSWORD=
DB_USER=budodesk_app
DB_PASSWORD=
DB_NAME=budodesk                       # no cambiar: el esquema crea la base "budodesk"

# ---- Seguridad ----
JWT_ACCESS_SECRET=                     # mínimo 32 caracteres
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=                          # vacío: la app y el API comparten dominio detrás de nginx
TRUST_PROXY=2                          # nginx + tu proxy de entrada (Cloudflare/NPM). Si llegas directo a nginx: 1

# ---- Correo (Hostinger) ----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@budodesk.com
SMTP_PASS=
MAIL_FROM=BudoDesk <no-reply@budodesk.com>

# ---- Tareas automáticas ----
BILLING_SCHEDULER=true                 # facturación, sesiones y recordatorios cada hora
