# Solo para correr el backend FUERA de Docker (npm run dev).
# Con Docker, la configuración vive en el .env de la raíz del repo.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=budodesk_app
DB_PASSWORD=local-password
DB_NAME=budodesk

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY=0
APP_BASE_URL=http://localhost:8081
# Sin SMTP_HOST los correos se imprimen en consola
